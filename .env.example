# Скопируйте этот файл в .env и заполните реальными данными.
# .env НИКОГДА не коммитить в git (добавьте в .gitignore).
# На Railway эти же переменные задаются в Settings -> Variables,
# .env файл там не используется.

YESPOS_ORG_ID=YESPOS_ORG_ID
YESPOS_LOGIN=YESPOS_LOGIN
YESPOS_PASSWORD=YESPOS_LOGIN
YESPOS_HEADLESS=true
